---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import ScrollRing from "../components/ScrollRing.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
---
<Base title={`页面未找到 404 | ${site.name}`} noindex={true}>
  <Topbar path="/404" />
  <main>
    <section class="nf-hero">
      <ScrollRing images={site.ring} radius={360} scrollSpeed={0.02} autoSpin={2} />
      <div class="nf-content">
        <h1 class="h1">404 · 页面未找到</h1>
        <p class="body muted balance nf-text">您所访问的测速报告或机场评测页面可能已下线或迁移至新专题。请返回首页或查阅 42 家品牌库。</p>
        <a class="btn" href="/"><span class="body-sb">返回首页观测台</span><Icon name="arrow-up-right" size={20} /></a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
