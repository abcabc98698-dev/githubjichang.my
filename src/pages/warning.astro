<script is:inline>
  // Interactive Safety Calculator Engine
  document.addEventListener("DOMContentLoaded", () => {
    const calcApp = document.getElementById("calc-app");
    if (!calcApp) return;

    const scoreText = document.getElementById("score-text");
    const gradeBadge = document.getElementById("grade-badge");
    const verdictTitle = document.getElementById("verdict-title");
    const verdictDesc = document.getElementById("verdict-desc");

    const optionGroups = calcApp.querySelectorAll(".calc-options-group");

    function recalculate() {
      let total = 0;
      optionGroups.forEach((group) => {
        const checked = group.querySelector("input:checked");
        if (checked) {
          total += parseInt(checked.value, 10);
        }
      });

      if (scoreText) scoreText.textContent = total;

      if (total >= 80) {
        if (gradeBadge) {
          gradeBadge.textContent = "安全可信 (大厂品质)";
          gradeBadge.className = "calc-grade-badge grade-safe";
        }
        if (verdictTitle) {
          verdictTitle.textContent = "诊断结论：🟢 安全可信（大厂品质）";
          verdictTitle.style.color = "#00e676";
        }
        if (verdictDesc) {
          verdictDesc.textContent =
            "当前得分在 80 分以上，该品牌拥有充沛的现金储备、自研技术积淀与成熟的物理专线储备。在全网极端敏感期与海缆事故中表现出色，跑路风险趋近于零，适合长期订阅与作为主力工作流使用（如光速云）。";
        }
      } else if (total >= 60) {
        if (gradeBadge) {
          gradeBadge.textContent = "中度风险 (建议仅月付)";
          gradeBadge.className = "calc-grade-badge grade-warning";
        }
        if (verdictTitle) {
          verdictTitle.textContent = "诊断结论：🟡 中度风险（建议仅月付体验）";
          verdictTitle.style.color = "#ffb300";
        }
        if (verdictDesc) {
          verdictDesc.textContent =
            "当前得分为 60-79 分，该品牌在线路冗余、社群透明度或抗封锁架构上存在一定短板。可能偶尔发生断流或延迟抖动，严禁一次性购买大额包年套餐，仅建议以小额月付形式试用。";
        }
      } else {
        if (gradeBadge) {
          gradeBadge.textContent = "极度高危 (随时跑路)";
          gradeBadge.className = "calc-grade-badge grade-danger";
        }
        if (verdictTitle) {
          verdictTitle.textContent = "诊断结论：🔴 极度高危（随时跑路，严禁充值）";
          verdictTitle.style.color = "#ff5252";
        }
        if (verdictDesc) {
          verdictDesc.textContent =
            "当前得分低于 60 分！该服务商具备典型的“月抛跑路盘”或“濒临破产盘”特征（如全员禁言、无自研能力、离谱超低价大促）。充值本金极大概率在 1-3 个月内彻底打水漂，请即刻停止续费并备份数据！";
        }
      }
    }

    // Attach listeners
    calcApp.querySelectorAll("input[type=radio]").forEach((input) => {
      input.addEventListener("change", (e) => {
        const group = e.target.closest(".calc-options-group");
        if (group) {
          group.querySelectorAll(".calc-option").forEach((opt) => opt.classList.remove("active"));
          e.target.closest(".calc-option")?.classList.add("active");
        }
        recalculate();
      });
    });

    // Initial calculation
    recalculate();
  });
</script>

