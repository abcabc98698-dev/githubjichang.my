---
import { site } from "../../lib/site";
import Icon from "../Icon.astro";

// Top 5 Flagship & High-Speed Brands for the 3D Carousel
const slides = [
  {
    src: "/assets/hero-pace.webp",
    alt: "光速云 专线网络",
    category: "★ #1 旗舰推荐 · 2020老牌IEPL专线 · ¥8/月起",
    title: "光速云",
    link: "/#flagship",
  },
  {
    src: "/assets/hero-fauna.webp",
    alt: "飞猫云 专属客户端",
    category: "专属免配置客户端 · 登录即连 · 8折优惠",
    title: "飞猫云",
    link: "/brands/feimao",
  },
  {
    src: "/assets/hero-lumen.webp",
    alt: "微风网络 智能调度",
    category: "IEPL专线 + VLESS · 7×24h智能客服 · 7元档",
    title: "微风网络",
    link: "/brands/weifeng",
  },
  {
    src: "/assets/hero-orbit.webp",
    alt: "星岛梦 永久不过期",
    category: "2020老牌 · 1倍率不限设备 · 永久不限时套餐",
    title: "星岛梦",
    link: "/brands/xingdaomeng",
  },
  {
    src: "/assets/hero-halo.webp",
    alt: "无忧链接 跨境电商",
    category: "跨境电商与TikTok直连 · 6.5元/月起步",
    title: "无忧链接",
    link: "/brands/wuyou",
  },
];
const n = slides.length;
---
<section id="hero" class="hero container">
  <div class="hero-stage">
    <div style="width: 100%; position: relative; display: flex; flex-direction: column; align-items: center">
      <div class="pc-root" style={`--n: ${n}`} data-carousel data-slides={JSON.stringify(slides.map((s) => s.src))}>
        <div class="pc-sticky">
          <canvas class="pc-canvas"></canvas>
          <div class="pc-overlays">
            {slides.map((s, i) => (
              <div class={"pc-center pc-overlay" + (i === 0 ? " pc-ref-active" : "")} style={`--i: ${i}`} data-overlay>
                <a class="pc-ref-link" href={s.link} aria-label={`查看 ${s.title}`}>
                  <span class="pc-ref-ltr pc-cat">{s.category}</span>
                  <h2 class="pc-title">
                    {s.title.split("").map((ch, li) => (
                      <span class="pc-ref-ltr" style={`transition-delay: ${(0.12 + li * 0.03).toFixed(2)}s`}>{ch}</span>
                    ))}
                  </h2>
                  <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                </a>
              </div>
            ))}
          </div>
          {n > 1 && (
            <div class="pc-bar" data-bar>
              {slides.map((s, i) => (
                <button type="button" class="pc-nav-btn" aria-label={`切换到 ${s.title}`} aria-current={i === 0 ? "true" : undefined} data-goto={i}>
                  <span class={"pc-nav-bar" + (i === 0 ? " pc-nav-active" : "")}></span>
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pc-fallback">
          {slides.map((s) => (
            <section class="pc-fb-slide pc-ref-active">
              <div class="pc-fb-media"><img src={s.src} alt={s.alt} loading="lazy" /></div>
              <div class="pc-center">
                <a class="pc-ref-link" href={s.link} aria-label={`查看 ${s.title}`}>
                  <span class="pc-ref-ltr pc-cat">{s.category}</span>
                  <h2 class="pc-title">{s.title.split("").map((ch) => <span class="pc-ref-ltr">{ch}</span>)}</h2>
                  <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                </a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="hero-bottom">
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <h1 class="h1" style="font-size: clamp(26px, 3.5vw, 42px); line-height: 1.15; margin: 0; color: var(--white);">
        github机场 · 专线网络测评观测台
      </h1>
      <p class="body balance hero-heading muted" style="margin: 0; font-size: 15px;">
        {site.tagline}
      </p>
    </div>
  </div>
</section>
