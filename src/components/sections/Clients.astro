---
import { CLIENT_GROUPS } from "../../data/clients";
import Icon from "../Icon.astro";
---
<section id="clients" class="clients-section container">
  <div class="clients-header">
    <div class="tag-row">
      <span class="mono-badge">ECOSYSTEM</span>
      <span class="caption muted">全平台第三方代理与专属客户端指南</span>
    </div>
    <h2 class="h2 clients-title">2026 客户端下载与双轨配置全景指南</h2>
    <p class="body muted balance">
      覆盖 Windows、macOS、iOS、Android、Linux 与 OpenWrt 软路由 6 大终端。针对不同用户层次提供“自研客户端（免配置登录即用）”与“通用开源客户端（订阅导入自由分流）”双重落地路径。
    </p>
  </div>

  <!-- Dual-Track Guide Callout -->
  <div class="dual-track-box">
    <div class="track-card track-a">
      <div class="track-badge">路线 A · 适合新手 / 懒人用户</div>
      <h3 class="body-sb" style="color: #00e676; font-size: 18px; margin: 8px 0;">⚡ 机场自研专属客户端（零门槛）</h3>
      <p class="caption muted">
        无需了解复杂的 YAML 配置、TUN 虚拟网卡或手动转换订阅链接。在光速云、飞猫云、微风网络等官网直接下载专属 App，输入账号密码登录后，一键点击连接即可畅游，10 秒内搞定。
      </p>
      <div class="track-steps caption">
        <span>① 官网注册下载 App</span> → <span>② 账号密码登录</span> → <span>③ 一键开启连接</span>
      </div>
    </div>

    <div class="track-card track-b">
      <div class="track-badge blue">路线 B · 适合进阶 / 多机场玩家</div>
      <h3 class="body-sb" style="color: #60a5fa; font-size: 18px; margin: 8px 0;">🛠️ 第三方通用开源客户端（高自由度）</h3>
      <p class="caption muted">
        基于开源内核（Mihomo / Xray / Sing-box）。支持同时聚合多家机场订阅，可精细配置国内直连、海外代理、特定 AI/流媒体分流规则，并具备跨平台测速与节点排序能力。
      </p>
      <div class="track-steps caption">
        <span>① 复制机场订阅链接</span> → <span>② 导入 Clash / 小火箭</span> → <span>③ 开启 TUN 模式</span>
      </div>
    </div>
  </div>

  <!-- OS Platform Tabs -->
  <div class="os-tabs" data-os-tabs>
    {CLIENT_GROUPS.map((os, idx) => (
      <button
        type="button"
        class:list={["os-tab-btn", { "is-active": idx === 0 }]}
        data-os-target={os.id}
      >
        <span>{os.name}</span>
      </button>
    ))}
  </div>

  <!-- OS Content Panels -->
  <div class="os-panels" data-os-panels>
    {CLIENT_GROUPS.map((os, idx) => (
      <div
        class="os-panel"
        data-os-panel={os.id}
        style={idx === 0 ? "display: block;" : "display: none;"}
      >
        <div class="os-meta-bar">
          <div>
            <h3 class="body-sb" style="color: var(--white); font-size: 18px;">{os.name} 核心代理工具推荐</h3>
            <p class="caption muted" style="margin-top: 4px;">{os.subtitle}</p>
          </div>
          {os.notice && (
            <div class="os-notice-pill caption">
              <span>💡 提示: {os.notice}</span>
            </div>
          )}
        </div>

        <div class="client-apps-grid">
          {os.apps.map((app) => (
            <div class="client-app-card">
              <div class="app-card-top">
                <div class="app-name-col">
                  <div class="app-title-row">
                    <h4 class="body-sb" style="color: var(--white); font-size: 16px;">{app.name}</h4>
                    {app.badge && <span class="app-badge">{app.badge}</span>}
                  </div>
                  <span class="caption muted font-mono" style="font-size: 11px;">核心: {app.core}</span>
                </div>
              </div>

              <p class="app-feature caption muted">{app.feature}</p>

              <div class="app-tags-row caption-xs">
                <span class="app-target-pill">适合: {app.targetUser}</span>
              </div>

              <div class="app-card-footer">
                <a
                  class="app-download-btn caption"
                  href={app.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{app.downloadLabel}</span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Tab switcher for OS client groups
  const root = document.querySelector<HTMLElement>("[data-os-tabs]");
  const panels = document.querySelectorAll<HTMLElement>("[data-os-panel]");

  if (root) {
    const btns = root.querySelectorAll<HTMLButtonElement>("[data-os-target]");
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        btns.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");

        const target = btn.dataset.osTarget;
        panels.forEach((p) => {
          if (p.dataset.osPanel === target) {
            p.style.display = "block";
          } else {
            p.style.display = "none";
          }
        });
      });
    });
  }
</script>

<style>
.clients-section {
  padding: 80px 20px;
}
.clients-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 40px;
}
.tag-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}
.mono-badge {
  font-family: monospace;
  font-size: 11px;
  color: #00e676;
  background: rgba(0, 230, 118, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
}
.clients-title {
  color: var(--white);
  font-size: clamp(26px, 3.5vw, 38px);
  margin-bottom: 16px;
}

/* Dual-Track Box */
.dual-track-box {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
  margin-bottom: 48px;
}
.track-card {
  border-radius: 14px;
  padding: 24px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.track-card.track-a {
  border-color: rgba(0, 230, 118, 0.3);
  background: rgba(0, 230, 118, 0.03);
}
.track-card.track-b {
  border-color: rgba(59, 130, 246, 0.3);
  background: rgba(59, 130, 246, 0.03);
}
.track-badge {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 6px;
  background: rgba(0, 230, 118, 0.15);
  color: #00e676;
}
.track-badge.blue {
  background: rgba(59, 130, 246, 0.15);
  color: #60a5fa;
}
.track-steps {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--white);
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* OS Tabs */
.os-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 12px;
}
.os-tab-btn {
  background: transparent;
  border: none;
  color: var(--white-60);
  padding: 10px 18px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.16s ease;
}
.os-tab-btn:hover {
  color: var(--white);
  background: rgba(255, 255, 255, 0.05);
}
.os-tab-btn.is-active {
  color: #00e676;
  background: rgba(0, 230, 118, 0.1);
}

/* OS Meta Bar */
.os-meta-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}
.os-notice-pill {
  background: rgba(255, 179, 0, 0.1);
  border: 1px solid rgba(255, 179, 0, 0.25);
  color: #ffb300;
  padding: 6px 14px;
  border-radius: 8px;
  max-width: 600px;
}

/* Apps Grid */
.client-apps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}
.client-app-card {
  background: #0d121c;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  transition: transform 0.16s ease, border-color 0.16s ease;
}
.client-app-card:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 230, 118, 0.35);
}
.app-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.app-badge {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  background: rgba(0, 230, 118, 0.15);
  color: #00e676;
}
.app-feature {
  margin: 12px 0;
  line-height: 1.5;
  min-height: 48px;
}
.app-tags-row {
  margin-bottom: 16px;
}
.app-target-pill {
  color: var(--white-60);
  background: rgba(255, 255, 255, 0.04);
  padding: 3px 8px;
  border-radius: 4px;
}
.app-card-footer {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}
.app-download-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  padding: 8px 14px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
  font-weight: 600;
  transition: background 0.16s ease, color 0.16s ease;
}
.app-download-btn:hover {
  background: #00e676;
  color: #121212;
}
</style>
