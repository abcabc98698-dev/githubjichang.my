---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
import ScrollFade from "../ScrollFade.astro";
const { about } = site;
---
<section id="about" class="about">
  <span id="about-alt" aria-hidden="true" style="position: absolute; top: 0; left: 0;"></span>
  <div class="about-stage">
    <div class="about-parallax" data-parallax>
      <div class="about-media">
        <img src="/assets/portrait.webp" alt={`${site.name} 独立网络工程师与架构师`} loading="lazy" />
      </div>
    </div>
    <div class="about-scrim" aria-hidden="true"></div>
    <div class="about-content">
      <div class="about-statement-row container">
        <div class="about-statement">
          <ScrollWords as="h2" class="h2 balance" style="text-align: end" text={about.statement} />
        </div>
      </div>
      <div class="about-bio-row container">
        <div class="about-bio-col">
          <p class="body-sb" style="color: #00e676; letter-spacing: 0.1em; font-family: monospace;">OBSERVATORY INTEL</p>
          <ScrollFade>
            <div class="about-paragraphs">
              <p class="body balance">{about.bio}</p>
              <p class="body balance">
                {about.contactLead} <a href={`mailto:${site.email}`} style="color: var(--white); text-decoration: underline;">{site.email}</a> {about.contactTail}
              </p>
            </div>
          </ScrollFade>
          <p class="caption muted" style="font-family: monospace;">GITHUB JICHANG OBSERVATORY — 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>
